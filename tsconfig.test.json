{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": ".test-build",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": false,
    "incremental": false
  },
  "include": [
    "tests/**/*.ts",
    "lib/numberInput.ts",
    "lib/argentinaCalculators.ts",
    "lib/guides.ts",
    "lib/calculations/**/*.ts",
    "lib/ai/apiResponse.ts",
    "lib/ai/providerResponse.ts",
    "lib/ai/telemetry.ts"
  ]
}
